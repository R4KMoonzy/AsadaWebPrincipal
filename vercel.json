{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": { "eq": "asadabijagua.com" } }],
      "destination": "https://www.asadabijagua.com/$1",
      "permanent": true
    }
  ]
}
